# Same application as Dockerfile; avoids slow Docker VM package networking.
FROM python:3.11.14-slim-bookworm
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
RUN useradd --create-home --uid 1000 ray
WORKDIR /app
COPY pyproject.toml ./
RUN --mount=type=bind,source=.wheelhouse,target=/wheels \
    python -c 'import tomllib; print("\n".join(tomllib.load(open("pyproject.toml", "rb"))["project"]["dependencies"]))' > /tmp/requirements.txt \
    && pip install --no-index --find-links=/wheels setuptools==80.9.0 wheel==0.45.1 -r /tmp/requirements.txt
COPY src ./src
RUN pip install --no-deps --no-build-isolation . \
    && python -m ray_platform.datasets --output /app/data \
    && mkdir /output && chown ray:ray /output
USER ray
ENV DATA_DIR=/app/data OUTPUT_DIR=/output
CMD ["python", "-m", "ray_platform.pipeline"]
